# Desenvolvimento sem Docker (npm run dev). Copie para apps/api/.env
NODE_ENV=development
# Dev local: um processo só com app dos clientes + painel (/admin). Em produção use tenant e platform separados.
API_SURFACE=all
DATABASE_OWNER_URL=postgres://g360_owner:SENHA@127.0.0.1:5433/gestao360
DATABASE_APP_URL=postgres://g360_app:SENHA@127.0.0.1:5433/gestao360
DATABASE_PLATFORM_URL=postgres://g360_platform:SENHA@127.0.0.1:5433/gestao360
BILLING_PROVIDER=fake
# Simulador de pagamento (só development + fake)
ENABLE_FAKE_CHECKOUT=true
BILLING_WEBHOOK_SECRET=
WORKER_INLINE=true
WEB_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
# Proxies na frente da API: false (nenhum), número de saltos (ex.: 1 para nginx) ou IPs. Nunca "true".
TRUST_PROXY=false
# Chave AES-256 que cifra os segredos TOTP do painel (openssl rand -hex 32)
PLATFORM_MFA_KEY=
