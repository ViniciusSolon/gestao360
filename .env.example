# Copie para .env e preencha com valores fortes (ex.: openssl rand -hex 24).
# NUNCA commite o .env. Nenhuma variável abaixo tem valor padrão no código.
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_PLATFORM_PASSWORD=
BILLING_WEBHOOK_SECRET=
# development ou production (obrigatório; sem default no compose)
NODE_ENV=
# fake (só development) ou stripe (produção)
BILLING_PROVIDER=
# true só em development + fake: habilita o botão "Simular pagamento"
ENABLE_FAKE_CHECKOUT=false
STRIPE_SECRET_KEY=
# Chave AES-256 dos segredos TOTP do painel (openssl rand -hex 32). Guarde no cofre; perder = recadastrar MFA.
PLATFORM_MFA_KEY=
